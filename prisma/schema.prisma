// prisma/schema.prisma
//
// TARGET state — применяется ПОСЛЕ SQL-миграции 001_normalize_parts_to_diagram_parts.sql
// Текущая БД этой схеме не соответствует до выполнения миграции.
// Tech debt: после применения raw SQL потребуется `prisma migrate baseline`
// чтобы синхронизировать историю Prisma.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════════════
// CATEGORY
// ═══════════════════════════════════════════════════════

model Category {
  id       Int    @id @default(autoincrement())
  name     String @unique @db.VarChar

  // Двухуровневое дерево категорий (категория → подкатегория)
  parentId Int?       @map("parent_id")
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")

  // SEO-поля (nullable — заполняются AI после парсинга)
  slug           String? @unique        @db.VarChar(255)
  seoTitle       String? @map("seo_title")       @db.VarChar(500)
  seoDescription String? @map("seo_description") @db.Text
  h1             String? @db.VarChar(500)
  content        String? @db.Text
  canonicalUrl   String? @map("canonical_url")   @db.VarChar(500)
  isIndexable    Boolean @default(true)  @map("is_indexable")

  // Нестандартные имена timestamp-колонок в существующей БД (без подчёркивания)
  createdAt DateTime @default(now()) @map("createdat") @db.Timestamptz
  updatedAt DateTime @updatedAt      @map("updatedat") @db.Timestamptz

  models Model[]

  @@index([parentId])
  @@map("categories")
}

// ═══════════════════════════════════════════════════════
// MODEL
// ═══════════════════════════════════════════════════════

model Model {
  id         Int    @id @default(autoincrement())
  name       String @unique @db.VarChar
  // Исторически хранит URL источника (servismakita.ru), не локальный путь
  imagePath  String @map("image_path") @db.VarChar
  categoryId Int    @map("category_id")

  // SEO-поля
  slug           String? @unique        @db.VarChar(255)
  seoTitle       String? @map("seo_title")       @db.VarChar(500)
  seoDescription String? @map("seo_description") @db.Text
  h1             String? @db.VarChar(500)
  content        String? @db.Text
  canonicalUrl   String? @map("canonical_url")   @db.VarChar(500)
  isIndexable    Boolean @default(true)  @map("is_indexable")

  createdAt DateTime @default(now()) @map("createdat") @db.Timestamptz
  updatedAt DateTime @updatedAt      @map("updatedat") @db.Timestamptz

  category     Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  slides       Slide[]
  diagramParts DiagramPart[]

  @@index([categoryId])
  @@map("models")
}

// ═══════════════════════════════════════════════════════
// SLIDE
// ═══════════════════════════════════════════════════════

model Slide {
  id          Int    @id @default(autoincrement())
  modelId     Int    @map("model_id")
  slideNumber Int    @map("slide_number")
  // Только имя файла: "HR2470_1.webp"
  // Полный путь строится как: /var/www/images/{category}/{model}/{imagePath}
  imagePath   String @map("image_path") @db.VarChar
  imageWidth  Float? @map("image_width")
  imageHeight Float? @map("image_height")

  // Явный флаг режима рендеринга взрыв-схемы.
  // false = DIV-оверлеи (координаты на DiagramPart)
  // true  = SVG-режим (<use xlink:href="#refN">)
  // Заменяет хрупкую логику: if (x_coord == null) → SVG
  hasSvg Boolean @default(false) @map("has_svg")

  createdAt DateTime @default(now()) @map("createdat") @db.Timestamptz
  updatedAt DateTime @updatedAt      @map("updatedat") @db.Timestamptz

  model        Model         @relation(fields: [modelId], references: [id], onDelete: Cascade)
  diagramParts DiagramPart[]

  @@unique([modelId, slideNumber])
  @@index([modelId])
  @@map("slides")
}

// ═══════════════════════════════════════════════════════
// PART  (физическая запчасть)
// ═══════════════════════════════════════════════════════

model Part {
  id         Int     @id @default(autoincrement())
  // Артикул Makita — уникален в каталоге, является ключом дедупликации
  partNumber String  @unique @map("part_number") @db.VarChar
  name       String? @db.VarChar  // nullable: не у всех деталей есть название

  price        Float   @default(0)
  availability Boolean @default(true)
  // quantity всегда 0 в текущих данных — сохраняем для совместимости
  quantity     Int     @default(0)

  // SEO-поля (slug = sanitize(partNumber))
  slug           String? @unique        @db.VarChar(255)
  seoTitle       String? @map("seo_title")       @db.VarChar(500)
  seoDescription String? @map("seo_description") @db.Text
  h1             String? @db.VarChar(500)
  content        String? @db.Text
  isIndexable    Boolean @default(true)  @map("is_indexable")

  // Новые таблицы используют стандартные имена с подчёркиванием
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt      @map("updated_at") @db.Timestamptz

  diagramParts DiagramPart[]
  orderItems   OrderItem[]

  @@map("parts")
}

// ═══════════════════════════════════════════════════════
// DIAGRAM PART  (вхождение детали в взрыв-схему модели)
// ═══════════════════════════════════════════════════════

model DiagramPart {
  id      Int  @id @default(autoincrement())
  modelId Int  @map("model_id")
  partId  Int  @map("part_id")
  slideId Int? @map("slide_id")  // nullable: деталь может быть не привязана к слайду

  // Позиционный номер на схеме (кружок на рисунке).
  // -1 = парсер-дефолт при отсутствии номера.
  number  Int

  // Координаты для DIV-режима (null → SVG-режим, определяется через Slide.hasSvg)
  xCoord Float? @map("x_coord")
  yCoord Float? @map("y_coord")
  width  Float?
  height Float?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt      @map("updated_at") @db.Timestamptz

  model Model  @relation(fields: [modelId], references: [id], onDelete: Cascade)
  part  Part   @relation(fields: [partId], references: [id], onDelete: Restrict)
  slide Slide? @relation(fields: [slideId], references: [id], onDelete: SetNull)

  // Одна позиция (number) на схеме одной модели — уникальна
  // Проверено на реальных данных: дублей (model_id, number) нет
  @@unique([modelId, number])
  @@index([modelId])
  @@index([partId])
  @@index([slideId])
  @@map("diagram_parts")
}

// ═══════════════════════════════════════════════════════
// ORDER
// ═══════════════════════════════════════════════════════

model Order {
  id               Int            @id @default(autoincrement())
  name             String         @db.VarChar
  phone            String         @db.VarChar
  email            String         @db.VarChar
  deliveryMethod   DeliveryMethod @map("delivery_method")
  transportCompany String?        @map("transport_company") @db.VarChar
  city             String?        @db.VarChar
  street           String?        @db.VarChar
  house            String?        @db.VarChar
  apartment        String?        @db.VarChar
  comment          String?        @db.Text
  totalPrice       Float          @default(0) @map("total_price")
  status           OrderStatus    @default(NEW)

  // В текущей БД только created_at, updated_at отсутствует
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime? @updatedAt      @map("updated_at") @db.Timestamptz  // добавляется при миграции

  items OrderItem[]

  @@map("orders")
}

// ═══════════════════════════════════════════════════════
// ORDER ITEM
// ═══════════════════════════════════════════════════════

model OrderItem {
  id       Int   @id @default(autoincrement())
  orderId  Int   @map("order_id")
  // Ссылается на Part (физическую деталь).
  // В текущей БД колонка называется product_id — сохраняем имя для совместимости.
  // При миграции: old product_id (старый parts.id) → new Part.id через part_number.
  partId   Int   @map("product_id")
  quantity Int
  price    Float  // snapshot цены на момент заказа, не FK

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  part  Part  @relation(fields: [partId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@map("order_items")
}

// ═══════════════════════════════════════════════════════
// ENUMS
// Маппинг на существующие PostgreSQL enum-типы
// ═══════════════════════════════════════════════════════

enum DeliveryMethod {
  PICKUP          @map("Самовывоз")
  DELIVERY        @map("Доставка")
  REGION_SHIPPING @map("Отправка в регион")

  @@map("enum_orders_delivery_method")
}

enum OrderStatus {
  NEW        @map("Новый")
  PROCESSING @map("В обработке")
  SHIPPED    @map("Отправлен")
  COMPLETED  @map("Завершён")
  CANCELLED  @map("Отменён")

  @@map("enum_orders_status")
}
