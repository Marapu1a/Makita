---
import { SITE_URL } from '../lib/env'
import Layout from '../layouts/Layout.astro'
import { getCategory } from '../lib/api'
import pdfIndex from '../data/pdf-index.json'

const { category: categorySlug } = Astro.params

let data, models
try {
  ({ data, models } = await getCategory(categorySlug!))
} catch {
  return Astro.rewrite('/404')
}

const title = data.seoTitle || `${data.name} — запчасти Makita`
const description = data.seoDescription || `Каталог запчастей Makita для ${data.name}. Взрыв-схемы и оригинальные детали.`

const hasChildren = data.children && data.children.length > 0

// Путь к картинке категории (как на старом фронте)
const catImg = (name: string) =>
  `/images/categories/${encodeURIComponent(name.replace(/\s+/g, '_').replace(/[\/\\]/g, '_'))}.webp`

// PDF-модели этой категории (схемы, существующие только в PDF)
const pdfModels = (pdfIndex as { name: string; path: string; category: string }[])
  .filter((pdf) => pdf.category === data.name)
  .map((pdf) => ({
    ...pdf,
    path: pdf.path.split('/').map((seg) => encodeURIComponent(seg)).join('/'),
  }))

const SITE = SITE_URL
const breadcrumbsLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Каталог', item: `${SITE}/` },
    ...(data.parent
      ? [{ '@type': 'ListItem', position: 2, name: data.parent.name, item: `${SITE}/${data.parent.slug}` },
         { '@type': 'ListItem', position: 3, name: data.name, item: `${SITE}/${data.slug}` }]
      : [{ '@type': 'ListItem', position: 2, name: data.name, item: `${SITE}/${data.slug}` }]),
  ],
}
---

<Layout title={title} description={description}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbsLd)} />
  </Fragment>

  <Fragment slot="breadcrumbs">
    <a href="/" class="hover:text-makita transition-colors">Каталог</a>
    <span class="mx-1">/</span>
    {data.parent && (
      <>
        <a href={`/${data.parent.slug}`} class="hover:text-makita transition-colors">{data.parent.name}</a>
        <span class="mx-1">/</span>
      </>
    )}
    <span class="text-ink">{data.name}</span>
  </Fragment>

  <div>
    <h1 class="text-2xl md:text-3xl font-medium uppercase tracking-tight mb-8">{data.name}</h1>

    {hasChildren ? (
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-4">
        {data.children!.map((child) => (
          <a
            href={`/${child.slug}`}
            class="group tile p-4 flex flex-col items-center gap-2"
          >
            <img
              src={catImg(child.name)}
              alt={child.name}
              loading="lazy"
              class="h-24 sm:h-28 object-contain"
            />
            <p class="text-sm font-medium text-center break-words line-clamp-2 group-hover:text-makita transition-colors">
              {child.name}
            </p>
          </a>
        ))}
      </div>
    ) : (
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-6 gap-3">
        {models.map((model) => (
          <a
            href={`/${categorySlug}/${model.slug}`}
            class="tile px-4 py-5 flex items-center justify-center text-center hover:text-makita"
          >
            <span class="text-sm font-medium break-words line-clamp-2">{model.name}</span>
          </a>
        ))}
        {pdfModels.map((model) => (
          <a
            href={model.path}
            target="_blank"
            rel="noopener noreferrer"
            class="tile px-4 py-5 flex items-center justify-center text-center"
          >
            <span class="text-sm font-medium break-words line-clamp-2 border-b border-ink">
              {model.name}&nbsp;→
            </span>
          </a>
        ))}
      </div>
    )}

    {!hasChildren && models.length === 0 && pdfModels.length === 0 && (
      <p class="text-gray-500">Модели не найдены.</p>
    )}
  </div>
</Layout>
