---
import Layout from '../layouts/Layout.astro'
import { getCategory } from '../lib/api'
import pdfIndex from '../data/pdf-index.json'

const { category: categorySlug } = Astro.params

let data, models
try {
  ({ data, models } = await getCategory(categorySlug!))
} catch {
  return Astro.rewrite('/404')
}

const title = data.seoTitle || `${data.name} — запчасти Makita`
const description = data.seoDescription || `Каталог запчастей Makita для ${data.name}. Взрыв-схемы и оригинальные детали.`

const hasChildren = data.children && data.children.length > 0

// Путь к картинке категории (как на старом фронте)
const catImg = (name: string) =>
  `/images/categories/${encodeURIComponent(name.replace(/\s+/g, '_').replace(/[\/\\]/g, '_'))}.webp`

// PDF-модели этой категории (схемы, существующие только в PDF)
const pdfModels = (pdfIndex as { name: string; path: string; category: string }[])
  .filter((pdf) => pdf.category === data.name)
  .map((pdf) => ({
    ...pdf,
    path: pdf.path.split('/').map((seg) => encodeURIComponent(seg)).join('/'),
  }))

const SITE = import.meta.env.SITE_URL || 'https://makita-remont.ru'
const breadcrumbsLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Каталог', item: `${SITE}/` },
    ...(data.parent
      ? [{ '@type': 'ListItem', position: 2, name: data.parent.name, item: `${SITE}/${data.parent.slug}` },
         { '@type': 'ListItem', position: 3, name: data.name, item: `${SITE}/${data.slug}` }]
      : [{ '@type': 'ListItem', position: 2, name: data.name, item: `${SITE}/${data.slug}` }]),
  ],
}
---

<Layout title={title} description={description}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbsLd)} />
  </Fragment>

  <Fragment slot="breadcrumbs">
    <a href="/" class="hover:text-blue-600">Каталог</a>
    <span class="mx-1">/</span>
    {data.parent && (
      <>
        <a href={`/${data.parent.slug}`} class="hover:text-blue-600">{data.parent.name}</a>
        <span class="mx-1">/</span>
      </>
    )}
    <span class="text-gray-700">{data.name}</span>
  </Fragment>

  <div class="flex flex-1 flex-col items-center px-4">
    <h1 class="text-2xl font-bold mb-6 self-start">{data.name}</h1>

    {hasChildren ? (
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4 w-full max-w-screen-lg">
        {data.children!.map((child) => (
          <a href={`/${child.slug}`}>
            <div class="bg-white p-4 rounded-md shadow-md hover:shadow-lg transition flex flex-col items-center">
              <img
                src={catImg(child.name)}
                alt={child.name}
                loading="lazy"
                class="h-24 sm:h-28 lg:h-32 object-contain mb-2"
              />
              <p class="text-sm font-semibold text-center break-words line-clamp-2">
                {child.name}
              </p>
            </div>
          </a>
        ))}
      </div>
    ) : (
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4 w-full max-w-screen-lg">
        {models.map((model) => (
          <a href={`/${categorySlug}/${model.slug}`}>
            <div class="bg-white p-4 rounded-md shadow-md hover:shadow-lg transition flex flex-col items-center">
              <p class="text-sm font-semibold text-center break-words line-clamp-2">
                {model.name}
              </p>
            </div>
          </a>
        ))}
        {pdfModels.map((model) => (
          <a href={model.path} target="_blank" rel="noopener noreferrer">
            <div class="bg-white p-4 rounded-md shadow-md hover:bg-gray-100 flex flex-col items-center">
              <p class="text-sm font-semibold text-blue-600 underline text-center break-words line-clamp-2">
                {model.name}
              </p>
            </div>
          </a>
        ))}
      </div>
    )}

    {!hasChildren && models.length === 0 && pdfModels.length === 0 && (
      <p class="text-gray-500">Модели не найдены.</p>
    )}
  </div>
</Layout>
