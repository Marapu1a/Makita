---
import Layout from '../../layouts/Layout.astro'
import Diagram from '../../components/Diagram'
import { getModel } from '../../lib/api'

const { model: modelSlug, category: categorySlug } = Astro.params

let model
try {
  model = await getModel(modelSlug!)
} catch {
  return Astro.rewrite('/404')
}

// Модель ищется по слагу — если в URL чужая категория, 301 на канонический адрес
if (model.category.slug && model.category.slug !== categorySlug) {
  return Astro.redirect(`/${model.category.slug}/${model.slug}`, 301)
}

const title = model.seoTitle || `${model.name} — взрыв-схема и запчасти Makita`
const description = model.seoDescription || `Взрыв-схема ${model.name}. Оригинальные запчасти Makita с артикулами и ценами.`

const SITE = import.meta.env.SITE_URL || 'https://makita-remont.ru'
const breadcrumbsLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Каталог', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: model.category.name, item: `${SITE}/${model.category.slug}` },
    { '@type': 'ListItem', position: 3, name: model.name, item: `${SITE}/${model.category.slug}/${model.slug}` },
  ],
}
---

<Layout
  title={title}
  description={description}
  noindex={!model.isIndexable}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbsLd)} />
  </Fragment>

  <Fragment slot="breadcrumbs">
    <a href="/" class="hover:text-blue-600">Каталог</a>
    <span class="mx-1">/</span>
    <a href={`/${categorySlug}`} class="hover:text-blue-600">{model.category.name}</a>
    <span class="mx-1">/</span>
    <span class="text-gray-700">{model.name}</span>
  </Fragment>

  <h1 class="text-xl font-bold mb-4">{model.h1 || model.name}</h1>

  <Diagram
    model={model}
    client:load
  />

  {model.content && (
    <div class="mt-10 prose max-w-none" set:html={model.content} />
  )}
</Layout>
