---
import Layout from '../layouts/Layout.astro'
import { getCategories } from '../lib/api'

const categories = await getCategories()
---

<Layout
  title="Каталог запчастей Makita — взрыв-схемы и оригинальные детали"
  description="Интернет-магазин оригинальных запчастей Makita. Взрыв-схемы, артикулы, цены."
>
  <h1 class="text-2xl font-bold mb-6">Каталог запчастей Makita</h1>

  <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4">
    {categories.map((cat) => (
      <a
        href={`/${cat.slug}`}
        class="bg-white rounded-xl shadow-sm border border-gray-100 hover:shadow-md hover:border-blue-200 transition-all p-4 flex flex-col items-center text-center gap-2"
      >
        <span class="text-sm font-medium leading-tight">{cat.name}</span>
        {cat.children && cat.children.length > 0 && (
          <span class="text-xs text-gray-400">{cat.children.length} подкатегорий</span>
        )}
      </a>
    ))}
  </div>
</Layout>
