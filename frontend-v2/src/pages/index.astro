---
import Layout from '../layouts/Layout.astro'
import { getCategories } from '../lib/api'

const categories = await getCategories()

// Путь к картинке категории: пробелы и слэши → подчёркивания (как на старом фронте)
const catImg = (name: string) =>
  `/images/categories/${encodeURIComponent(name.replace(/\s+/g, '_').replace(/[\/\\]/g, '_'))}.webp`
---

<Layout
  title="Каталог запчастей Makita — взрыв-схемы и оригинальные детали"
  description="Интернет-магазин оригинальных запчастей Makita. Взрыв-схемы, артикулы, цены."
>
  <div class="relative">
    <!-- Архитектурный фоновый слой: контурный текст за контентом -->
    <div
      aria-hidden="true"
      class="pointer-events-none select-none absolute -top-8 left-0 right-0 overflow-hidden hidden md:block"
    >
      <span
        class="block font-medium uppercase whitespace-nowrap leading-none text-transparent"
        style="font-size: clamp(120px, 18vw, 280px); -webkit-text-stroke: 1px rgba(0,0,0,0.08);"
      >
        MAKITA
      </span>
    </div>

    <div class="relative pt-4 md:pt-24">
      <h1 class="text-2xl md:text-4xl font-medium uppercase tracking-tight mb-8">
        Каталог запчастей
      </h1>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 border-t border-l border-ink">
        {categories.map((category) => (
          <a
            href={`/${category.slug}`}
            class="group border-r border-b border-ink p-4 flex flex-col items-center gap-2 hover:bg-gray-50 transition-colors"
          >
            <img
              src={catImg(category.name)}
              alt={category.name}
              loading="lazy"
              class="h-24 sm:h-28 object-contain"
            />
            <p class="text-sm font-medium text-center break-words line-clamp-2 group-hover:text-makita transition-colors">
              {category.name}
            </p>
          </a>
        ))}
      </div>
    </div>
  </div>
</Layout>
