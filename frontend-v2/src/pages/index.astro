---
import Layout from '../layouts/Layout.astro'
import { getCategories } from '../lib/api'

const categories = await getCategories()

// Путь к картинке категории: пробелы и слэши → подчёркивания (как на старом фронте)
const catImg = (name: string) =>
  `/images/categories/${encodeURIComponent(name.replace(/\s+/g, '_').replace(/[\/\\]/g, '_'))}.webp`
---

<Layout
  title="Каталог запчастей Makita — взрыв-схемы и оригинальные детали"
  description="Интернет-магазин оригинальных запчастей Makita. Взрыв-схемы, артикулы, цены."
>
  <div class="flex flex-1 flex-col items-center px-4">
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4 w-full max-w-screen-lg">
      {categories.map((category) => (
        <a href={`/${category.slug}`}>
          <div class="bg-white p-4 rounded-md shadow-md hover:shadow-lg transition flex flex-col items-center">
            <img
              src={catImg(category.name)}
              alt={category.name}
              loading="lazy"
              class="h-24 sm:h-28 lg:h-32 object-contain mb-2"
            />
            <p class="text-sm font-semibold text-center break-words line-clamp-2">
              {category.name}
            </p>
          </div>
        </a>
      ))}
    </div>
  </div>
</Layout>
