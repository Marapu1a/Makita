---
import { API_BASE, SITE_URL } from '../../lib/env'
import Layout from '../../layouts/Layout.astro'
import AddToCart from '../../components/AddToCart'
import { fmtPrice } from '../../lib/format'

interface UsedIn {
  modelId: number
  modelName: string
  modelSlug: string | null
  category: string
  categorySlug: string | null
  number: number
  slideNumber: number | null
}

const { slug } = Astro.params
const apiBase = API_BASE

let part
try {
  const res = await fetch(`${apiBase}/api/v2/parts/by-slug/${encodeURIComponent(slug!)}`)
  if (!res.ok) return Astro.rewrite('/404')
  ;({ data: part } = await res.json())
} catch {
  return Astro.rewrite('/404')
}

const usedIn: UsedIn[] = part.usedIn
const displayName = part.name || `Деталь ${part.partNumber}`

// Группировка вхождений: одна строка на модель, позиции списком
interface GroupedModel {
  modelName: string
  modelSlug: string | null
  category: string
  categorySlug: string | null
  positions: number[]
}
const groupedModels: GroupedModel[] = []
{
  const byModel = new Map<number, GroupedModel>()
  for (const u of usedIn) {
    let g = byModel.get(u.modelId)
    if (!g) {
      g = {
        modelName: u.modelName,
        modelSlug: u.modelSlug,
        category: u.category,
        categorySlug: u.categorySlug,
        positions: [],
      }
      byModel.set(u.modelId, g)
      groupedModels.push(g)
    }
    g.positions.push(u.number)
  }
  for (const g of groupedModels) g.positions.sort((a, b) => a - b)
}

const title = part.seoTitle
  || `${displayName} (${part.partNumber}) — купить оригинальную запчасть Makita`
const description = part.seoDescription
  || `Оригинальная запчасть Makita: ${displayName}, артикул ${part.partNumber}. ${
    part.price > 0 ? `Цена ${Math.ceil(part.price)} ₽. ` : ''
  }Используется в ${usedIn.length} моделях. Заказ онлайн, доставка по России.`
const h1 = part.h1 || `${displayName} — артикул ${part.partNumber}`

const modelsWord = (() => {
  const n = groupedModels.length
  if ([11, 12, 13, 14].includes(n % 100)) return 'моделях'
  if (n % 10 === 1) return 'модели'
  return 'моделях'
})()

const SITE = SITE_URL
const pageUrl = `${SITE}/parts/${part.slug}`

const productLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: displayName,
  sku: part.partNumber,
  brand: { '@type': 'Brand', name: 'Makita' },
  url: pageUrl,
  ...(part.price > 0 && {
    offers: {
      '@type': 'Offer',
      url: pageUrl,
      price: Math.ceil(part.price),
      priceCurrency: 'RUB',
      availability: part.availability
        ? 'https://schema.org/InStock'
        : 'https://schema.org/OutOfStock',
    },
  }),
}

const breadcrumbsLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Каталог', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: `Артикул ${part.partNumber}`, item: pageUrl },
  ],
}
---

<Layout title={title} description={description} noindex={!part.isIndexable} sidebar={false}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(productLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbsLd)} />
  </Fragment>

  <Fragment slot="breadcrumbs">
    <a href="/" class="hover:text-makita transition-colors">Каталог</a>
    <span class="mx-1">/</span>
    <span class="text-ink">Артикул {part.partNumber}</span>
  </Fragment>

  <div class="max-w-4xl">
    <h1 class="text-2xl md:text-3xl font-medium tracking-tight mb-6">{h1}</h1>

    <div class="border border-ink p-6 mb-10 flex flex-col sm:flex-row sm:items-center gap-6">
      <div class="flex-1">
        <p class="text-[11px] uppercase tracking-wider text-gray-500 mb-1">
          Артикул
        </p>
        <p class="font-mono text-lg font-medium mb-3">{part.partNumber}</p>
        {part.name && <p class="text-lg mb-3">{part.name}</p>}
        <p class="mb-2 flex items-center gap-2 text-sm">
          <span class={`inline-block w-2 h-2 ${part.availability ? 'bg-green-600' : 'bg-red-500'}`} />
          {part.availability ? 'В наличии' : 'Нет в наличии'}
        </p>
        {part.price > 0 && (
          <p class="text-3xl font-medium">{fmtPrice(part.price)}</p>
        )}
      </div>
      <AddToCart
        client:load
        part={{
          id: part.id,
          part_number: part.partNumber,
          name: displayName,
          price: part.price,
        }}
        available={part.availability}
      />
    </div>

    {part.content && <div class="prose max-w-none mb-10" set:html={part.content} />}

    {groupedModels.length > 0 && (
      <section>
        <h2 class="text-[11px] font-medium uppercase tracking-widest text-gray-500 mb-3">
          Используется в {groupedModels.length} {modelsWord}
        </h2>
        <div class="overflow-x-auto border border-ink">
          <table class="min-w-full border-collapse text-sm">
            <thead>
              <tr class="text-left text-[11px] uppercase tracking-wider text-gray-500">
                <th class="border-b border-ink px-3 py-2 font-medium">Модель</th>
                <th class="border-b border-ink px-3 py-2 font-medium">Категория</th>
                <th class="border-b border-ink px-3 py-2 font-medium">Позиции на схеме</th>
              </tr>
            </thead>
            <tbody>
              {groupedModels.map((g) => (
                <tr class="border-b border-gray-200 hover:bg-gray-50 transition-colors">
                  <td class="px-3 py-2">
                    <a
                      href={`/${g.categorySlug}/${g.modelSlug}`}
                      class="font-medium border-b border-gray-300 hover:border-makita hover:text-makita transition-colors"
                    >
                      {g.modelName}
                    </a>
                  </td>
                  <td class="px-3 py-2 text-gray-500">{g.category}</td>
                  <td class="px-3 py-2">{g.positions.join(', ')}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )}
  </div>
</Layout>
