---
import Layout from '../layouts/Layout.astro'
---

<Layout title="Страница не найдена — запчасти Makita" noindex={true} sidebar={false}>
  <div class="relative overflow-hidden py-20">
    <!-- Архитектурный фоновый слой -->
    <div
      aria-hidden="true"
      class="pointer-events-none select-none absolute inset-0 flex items-center justify-center"
    >
      <span
        class="font-medium leading-none text-transparent whitespace-nowrap"
        style="font-size: clamp(200px, 40vw, 560px); -webkit-text-stroke: 1px rgba(0,0,0,0.08);"
      >
        404
      </span>
    </div>

    <div class="relative text-center py-16">
      <h1 class="text-3xl font-medium uppercase tracking-tight mb-3">Страница не найдена</h1>
      <p class="text-gray-500 mb-8 max-w-md mx-auto">
        Возможно, страница была перемещена или удалена.
        Воспользуйтесь поиском или вернитесь в каталог.
      </p>
      <a
        href="/"
        class="inline-block px-8 py-3 text-sm font-medium uppercase tracking-wider bg-ink text-white hover:bg-makita transition-colors"
      >
        В каталог&nbsp;→
      </a>
    </div>
  </div>
</Layout>
