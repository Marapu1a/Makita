---
import { SITE_URL } from '../lib/env'
import '../styles/global.css'
import Header from '../components/Header'
import TopBar from '../components/TopBar'
import { getCategories } from '../lib/api'

interface Props {
  title: string
  description?: string
  noindex?: boolean
  sidebar?: boolean
  /** Канонический путь страницы (без домена); по умолчанию — текущий путь */
  canonicalPath?: string
}

const { title, description, noindex, sidebar = true, canonicalPath } = Astro.props
const currentPath = Astro.url.pathname

const SITE = SITE_URL
const canonical = noindex ? null : `${SITE}${canonicalPath ?? currentPath}`

// Корневые категории для сайдбара
const categories = sidebar ? await getCategories() : []
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    {canonical && <link rel="canonical" href={canonical} />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:site_name" content="Запчасти Makita — makita-remont.ru" />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:image" content={`${SITE}/images/brand/og-image.jpg`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.ico" />
    <slot name="head" />
  </head>
  <body class="min-h-screen bg-paper text-ink flex flex-col">
    <Header client:load />
    <TopBar currentPath={currentPath} client:load />

    <div class="flex flex-1">
      {sidebar && (
        <aside class="w-60 shrink-0 border-r border-ink hidden lg:block">
          <h2 class="px-5 pt-6 pb-3 text-[11px] font-medium uppercase tracking-widest text-gray-500">
            Категории
          </h2>
          <ul>
            {categories.map((category) => (
              <li>
                <a
                  href={`/${category.slug}`}
                  class={`block px-5 py-1.5 text-sm border-l-2 transition-colors ${
                    currentPath === `/${category.slug}`
                      ? 'border-makita text-makita font-medium'
                      : 'border-transparent hover:border-makita hover:text-makita'
                  }`}
                >
                  {category.name}
                </a>
              </li>
            ))}
          </ul>
        </aside>
      )}

      <main class="px-5 py-6 flex-1 max-w-[100vw] min-w-0">
        <div class="text-sm text-gray-500 mb-3">
          <slot name="breadcrumbs" />
        </div>
        <slot />
      </main>
    </div>

    <footer class="border-t border-ink mt-20">
      <div class="px-5 py-8 flex flex-col gap-4 text-sm">
        <div class="flex flex-col sm:flex-row sm:items-center gap-3 sm:gap-8">
          <img src="/images/brand/snabtools-logo.png" alt="Снабтулс" class="h-7 w-auto" />
          <a href="/privacy-policy" class="border-b border-ink hover:border-transparent transition-colors w-fit">
            Политика конфиденциальности
          </a>
          <a href="/contacts" class="border-b border-ink hover:border-transparent transition-colors w-fit">
            Контакты
          </a>
        </div>
        <p class="text-xs leading-relaxed text-gray-500 max-w-4xl">
          © При использовании материалов с сайта makita-remont.ru активная ссылка
          на источник обязательна. Интернет-сайт makita-remont.ru носит
          исключительно информационный характер и не является публичной офертой,
          определяемой положениями Статьи 437 (2) Гк РФ. Присланное по e-mail
          сообщение, содержащее копию заполненной формы заявки на сайте, не
          является ответом на сообщение потребителя или подтверждением заказа со
          стороны владельцев сайта.
        </p>
      </div>
    </footer>
  </body>
</html>
