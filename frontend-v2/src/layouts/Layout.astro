---
import '../styles/global.css'
import Header from '../components/Header'

interface Props {
  title: string
  description?: string
  noindex?: boolean
}

const { title, description, noindex } = Astro.props
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <link rel="icon" href="/favicon.ico" />
  </head>
  <body class="min-h-screen bg-gray-50 text-gray-900">
    <Header client:load />

    <div class="max-w-7xl mx-auto px-4 pt-3 text-sm text-gray-500">
      <slot name="breadcrumbs" />
    </div>

    <main class="max-w-7xl mx-auto px-4 py-6">
      <slot />
    </main>

    <footer class="mt-16 border-t border-gray-200 bg-white py-6 text-center text-sm text-gray-400">
      © {new Date().getFullYear()} Makita Запчасти. Все права защищены.
    </footer>
  </body>
</html>
