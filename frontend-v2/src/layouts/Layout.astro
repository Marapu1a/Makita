---
import '../styles/global.css'
import Header from '../components/Header'
import TopBar from '../components/TopBar'
import { getCategories } from '../lib/api'

interface Props {
  title: string
  description?: string
  noindex?: boolean
  sidebar?: boolean
  /** Канонический путь страницы (без домена); по умолчанию — текущий путь */
  canonicalPath?: string
}

const { title, description, noindex, sidebar = true, canonicalPath } = Astro.props
const currentPath = Astro.url.pathname

const SITE = import.meta.env.SITE_URL || 'https://makita-remont.ru'
const canonical = noindex ? null : `${SITE}${canonicalPath ?? currentPath}`

// Корневые категории для сайдбара
const categories = sidebar ? await getCategories() : []
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    {canonical && <link rel="canonical" href={canonical} />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:site_name" content="Запчасти Makita — makita-remont.ru" />
    <meta property="og:locale" content="ru_RU" />

    <link rel="icon" href="/favicon.ico" />
    <slot name="head" />
  </head>
  <body class="min-h-screen bg-gray-50 text-gray-900 flex flex-col">
    <Header client:load />
    <TopBar currentPath={currentPath} client:load />

    <div class="flex flex-1">
      {sidebar && (
        <aside class="md:max-w-[23%] lg:max-w-[18%] bg-gradient-to-b from-cyan-700 to-cyan-800 text-white p-4 hidden lg:block">
          <h2 class="font-bold mb-2 text-lg">Категории</h2>
          <ul class="w-full">
            {categories.map((category) => (
              <li>
                <a
                  href={`/${category.slug}`}
                  class={`block mb-1 cursor-pointer px-4 py-2 transition-all rounded-sm duration-100 ease-in-out ${
                    currentPath === `/${category.slug}`
                      ? 'bg-cyan-900 border-l-4 border-red-500'
                      : 'hover:bg-cyan-900 hover:border-l-4 hover:border-red-500'
                  }`}
                >
                  {category.name}
                </a>
              </li>
            ))}
          </ul>
        </aside>
      )}

      <main class="p-4 flex-1 max-w-[100vw]">
        <div class="text-sm text-gray-500 mb-2">
          <slot name="breadcrumbs" />
        </div>
        <slot />
      </main>
    </div>

    <footer class="bg-gray-800 text-white p-4 text-sm text-center w-full">
      <p class="underline">
        <a href="/privacy-policy">Политика конфиденциальности</a>
      </p>
      © При использовании материалов с сайта makita-remont.ru активная ссылка
      на источник обязательна. Интернет-сайт makita-remont.ru носит
      исключительно информационный характер и не является публичной офертой,
      определяемой положениями Статьи 437 (2) Гк РФ. Присланное по e-mail
      сообщение, содержащее копию заполненной формы заявки на сайте, не
      является ответом на сообщение потребителя или подтверждением заказа со
      стороны владельцев сайта.
    </footer>
  </body>
</html>
