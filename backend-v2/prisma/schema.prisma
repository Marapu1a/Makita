generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// КАНОНИЧЕСКАЯ схема БД (единственная в репо; бывший корневой /prisma — черновик — удалён).
// Состояние ПОСЛЕ нормализации 2026-07: parts — уникальные артикулы,
// diagram_parts — вхождения детали в схемы моделей.
// Схема управляется raw SQL-миграциями (migrations/sql), Prisma migrate не используется —
// после изменений схемы прогонять prisma validate + generate.

model Category {
  id             Int      @id @default(autoincrement())
  name           String   @unique @db.VarChar(255)
  parentId       Int?     @map("parent_id")
  createdAt      DateTime @map("createdat") @db.Timestamptz
  updatedAt      DateTime @map("updatedat") @db.Timestamptz
  slug           String?  @db.VarChar(255)
  seoTitle       String?  @map("seo_title") @db.VarChar(500)
  seoDescription String?  @map("seo_description") @db.Text

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  models   Model[]

  @@map("categories")
}

model Model {
  id             Int      @id @default(autoincrement())
  name           String   @unique @db.VarChar(255)
  imagePath      String   @map("image_path") @db.VarChar(255)
  categoryId     Int      @map("category_id")
  createdAt      DateTime @map("createdat") @db.Timestamptz
  updatedAt      DateTime @map("updatedat") @db.Timestamptz
  slug           String?  @db.VarChar(255)
  seoTitle       String?  @map("seo_title") @db.VarChar(500)
  seoDescription String?  @map("seo_description") @db.Text
  h1             String?  @db.VarChar(500)
  content        String?  @db.Text
  isIndexable    Boolean  @default(true) @map("is_indexable")

  category     Category      @relation(fields: [categoryId], references: [id])
  slides       Slide[]
  diagramParts DiagramPart[]

  @@map("models")
}

model Slide {
  id          Int      @id @default(autoincrement())
  modelId     Int      @map("model_id")
  slideNumber Int      @map("slide_number")
  imagePath   String   @map("image_path") @db.VarChar(255)
  imageWidth  Float?   @map("image_width")
  imageHeight Float?   @map("image_height")
  createdAt   DateTime @map("createdat") @db.Timestamptz
  updatedAt   DateTime @map("updatedat") @db.Timestamptz
  hasSvg      Boolean  @default(false) @map("has_svg")

  model        Model         @relation(fields: [modelId], references: [id])
  diagramParts DiagramPart[]

  @@unique([modelId, slideNumber])
  @@map("slides")
}

model Order {
  id               Int            @id @default(autoincrement())
  name             String         @db.VarChar(255)
  phone            String         @db.VarChar(255)
  email            String         @db.VarChar(255)
  deliveryMethod   DeliveryMethod @map("delivery_method")
  transportCompany String?        @map("transport_company") @db.VarChar(255)
  city             String?        @db.VarChar(255)
  street           String?        @db.VarChar(255)
  house            String?        @db.VarChar(255)
  apartment        String?        @db.VarChar(255)
  comment          String?        @db.Text
  totalPrice       Float          @default(0) @map("total_price")
  status           OrderStatus    @default(NEW)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime?      @updatedAt @map("updated_at") @db.Timestamptz

  items OrderItem[]

  @@map("orders")
}

model OrderItem {
  id        Int   @id @default(autoincrement())
  orderId   Int   @map("order_id")
  productId Int?  @map("product_id")
  quantity  Int
  price     Float

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  part  Part? @relation(fields: [productId], references: [id])

  @@map("order_items")
}

enum DeliveryMethod {
  PICKUP          @map("Самовывоз")
  DELIVERY        @map("Доставка")
  REGION_SHIPPING @map("Отправка в регион")

  @@map("enum_orders_delivery_method")
}

enum OrderStatus {
  NEW        @map("Новый")
  PROCESSING @map("В обработке")
  SHIPPED    @map("Отправлен")
  COMPLETED  @map("Завершён")
  CANCELLED  @map("Отменён")

  @@map("enum_orders_status")
}

// Физическая деталь — одна строка на артикул (после миграции 001)
model Part {
  id           Int     @id @default(autoincrement())
  partNumber   String  @unique @map("part_number") @db.VarChar
  name         String? @db.VarChar
  price        Float   @default(0)
  availability Boolean @default(true)
  quantity     Int     @default(0)

  slug           String? @unique @db.VarChar(255)
  seoTitle       String? @map("seo_title") @db.VarChar(500)
  seoDescription String? @map("seo_description") @db.Text
  h1             String? @db.VarChar(500)
  content        String? @db.Text
  isIndexable    Boolean @default(true) @map("is_indexable")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime? @map("updated_at") @db.Timestamptz

  diagramParts DiagramPart[]
  orderItems   OrderItem[]

  @@map("parts")
}

// Вхождение детали в взрыв-схему модели (позиция, координаты)
model DiagramPart {
  id      Int    @id @default(autoincrement())
  modelId Int    @map("model_id")
  partId  Int    @map("part_id")
  slideId Int?   @map("slide_id")
  number  Int
  xCoord  Float? @map("x_coord")
  yCoord  Float? @map("y_coord")
  width   Float?
  height  Float?

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime? @map("updated_at") @db.Timestamptz

  model Model  @relation(fields: [modelId], references: [id], onDelete: Cascade)
  part  Part   @relation(fields: [partId], references: [id], onDelete: Restrict)
  slide Slide? @relation(fields: [slideId], references: [id], onDelete: SetNull)

  @@unique([modelId, number])
  @@map("diagram_parts")
}
