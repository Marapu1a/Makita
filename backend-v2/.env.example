DATABASE_URL=postgresql://user:password@localhost:5432/makita
PORT=5001
IMAGES_PATH=/var/www/images

ADMIN_LOGIN=admin
ADMIN_PASSWORD=change-me
JWT_SECRET=change-me-to-a-long-random-value

# SMTP почты магазина. Для порта 465 используется TLS сразу,
# для 587 nodemailer автоматически переключается на STARTTLS.
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=shop@example.com
SMTP_PASS=change-me

# Необязательно: по умолчанию оба адреса равны SMTP_USER.
ORDER_NOTIFY_EMAIL=manager@example.com
ORDER_REPLY_EMAIL=manager@example.com
